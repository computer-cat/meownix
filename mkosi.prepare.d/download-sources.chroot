#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
cd .sources

# Prepare PKGBUILDs for offline builds
cp -R ../other_packages/* ./

cd greetd-dms-greeter-bin
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

cd ../z13ctl
env EUID=123 PATH=$(realpath .):$PATH makepkg -o