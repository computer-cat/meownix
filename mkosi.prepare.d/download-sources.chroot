#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
cd .sources
cp -R ../other_packages/* ./

#noctalia-greeter
cd noctalia-greeter
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#umbriel
cd ../umbriel-git
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#xdg-umbriel
cd ../xdg-desktop-portal-umbriel-git
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#gaze (face recognition)
cd ../gaze
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#pin xwayland-satellite
cd ..
mkdir pinned
cd pinned
curl -LO https://archive.archlinux.org/packages/x/xwayland-satellite/xwayland-satellite-0.8.1-2-x86_64.pkg.tar.zst