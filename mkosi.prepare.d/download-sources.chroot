#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
cd .sources

#noctalia-greeter
cp -R ../other_packages/* ./
cd noctalia-greeter
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#umbriel
cd ../umbriel-git
env -u BUILDDIR EUID=123 PATH=$(realpath .):$PATH makepkg -o
cd src/umbriel
git submodule update --init --recursive
cd ../../

#xdg-umbriel
cd ../xdg-desktop-portal-umbriel-git
env EUID=123 PATH=$(realpath .):$PATH makepkg -o