#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
cd .sources

#noctalia-greeter
cp -R ../other_packages/* ./
cd noctalia-greeter
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#umbriel
cd ../umbriel-git
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

#xdg-umbriel
cd ../xdg-desktop-portal-umbriel-git
env EUID=123 PATH=$(realpath .):$PATH makepkg -o