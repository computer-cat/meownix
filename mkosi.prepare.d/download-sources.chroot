#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
cd .sources

# Prepare greetd-dms-greeter-bin for offline build

# Ditto, with z13ctl
git clone https://aur.archlinux.org/z13ctl-bin.git 
cd z13ctl-bin
env EUID=123 PATH=$(realpath .):$PATH makepkg -o
cd ..

curl -LO https://archive.archlinux.org/packages/l/linux/linux-7.1.5.arch1-2-x86_64.pkg.tar.zst
curl -LO https://archive.archlinux.org/packages/l/linux/linux-headers-7.1.5.arch1-2-x86_64.pkg.tar.zst