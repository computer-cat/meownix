#!/usr/bin/env bash

set -uexo pipefail

if [ "$container" != "mkosi" ]; then
    exec mkosi-chroot "$CHROOT_SCRIPT" "$@"
fi

cd .sources/z13ctl-bin
env EUID=123 PATH=$(realpath .):$PATH makepkg --noprepare --clean --force --skippgpcheck

cp -r /tmp/gamescope-session/usr "$DESTDIR/"
cp -r /tmp/gamescope-session-steam/usr "$DESTDIR/"