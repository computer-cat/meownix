#!/usr/bin/env bash

set -uexo pipefail

if [ "$container" != "mkosi" ]; then
    exec mkosi-chroot "$CHROOT_SCRIPT" "$@"
fi


cd .sources/noctalia-greeter
env EUID=123 PATH=$(realpath .):$PATH makepkg --noprepare --clean --force --skippgpcheck

cd ../umbriel-git
env -u BUILDDIR EUID=123 PATH=$(realpath .):$PATH makepkg --noprepare --clean --force --skippgpcheck

cd ../xdg-desktop-portal-umbriel-git
env EUID=123 PATH=$(realpath .):$PATH makepkg --noprepare --clean --force --skippgpcheck